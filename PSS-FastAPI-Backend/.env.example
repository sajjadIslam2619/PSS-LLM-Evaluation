# Copy to .env and adjust. Development uses SQLite by default (no .env needed).

# Database: default is SQLite for development
# DATABASE_URL=sqlite:///./pss.db

# Production: PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/pss

# JWT secret – set in production
# SECRET_KEY=your-secret-key

# Shared login password. A real environment variable overrides this file.
# COMMON_PASSWORD=demo123

# Key for downloading saved data as CSV (GET /export?key=...). Not the participant password.
# EXPORT_KEY=choose-a-long-secret

# DEBUG=false

# Hugging Face: token for model load (Create your own post – detect labels).
# Order: 1) Environment variable (if set), 2) .env file.
# Get a token at https://huggingface.co/settings/tokens
#
# Set in environment (production or current shell):
#   Windows (PowerShell):  $env:HUGGINGFACE_TOKEN="hf_xxxxxxxxxxxx"
#   Windows (CMD):        set HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxx
#   macOS/Linux:          export HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxx
#
# Or set in .env (development):
# HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxx

# LLM for "Generate Response with AI". Any OpenAI-compatible Chat Completions API works.
# OPENAI_ENDPOINT is the base URL; leave it empty to use OpenAI directly (https://api.openai.com/v1).
#   OpenAI:       (leave empty)
#   AWS Bedrock:  https://bedrock-runtime.<region>.amazonaws.com/openai/v1
#   Azure:        https://<resource>.openai.azure.com/openai/v1/
# OPENAI_ENDPOINT=
# OPENAI_API_KEY=your-api-key
# OPENAI_MODEL=gpt-5.5-2026-04-23
# Optional. Leave unset for newer models, which only accept their default temperature.
# OPENAI_TEMPERATURE=0.7
